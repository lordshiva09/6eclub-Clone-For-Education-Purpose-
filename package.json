{
  "name": "6eclub-app",
  "version": "1.0.0",
  "private": true,
  "description": "6E.CLUB web application with shared Node.js backend database and real-time SSE cross-device sync",
  "main": "server.js",
  "scripts": {
    "build": "node --no-warnings scripts/build-netlify.js",
    "start": "node --no-warnings server.js",
    "dev:cf": "npm run build && wrangler dev --port 8787",
    "deploy:cf": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9"
  },
  "devDependencies": {
    "wrangler": "^4.160.1"
  }
}

{
  "name": "6eclub",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-05-15",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLUB_DO",
        "class_name": "ClubStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClubStateDO"]
    }
  ]
}
